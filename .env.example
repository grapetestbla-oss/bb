# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env
# deploy.sh делает это сам и генерирует секреты.
# ---------------------------------------------------------------------------

# --- KPGen (генератор коммерческих предложений) ---

# Ключ подписи сессионной куки. В проде обязателен: без него вход не работает.
# Сгенерировать: openssl rand -base64 32
KP_SESSION_SECRET=change-me-session-secret

# Ключ проверки подписи вебхука об оплате. В проде обязателен.
KP_WEBHOOK_SECRET=change-me-webhook-secret

# Необязательно. С ключом текст КП пишет Claude, без него — встроенный
# шаблонный сборщик (продукт работает в обоих случаях).
ANTHROPIC_API_KEY=

# --- BrawlBoost ---

NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# --- База ---
# В docker compose путь задаётся в самом compose-файле (/app/db/custom.db).
# Эта переменная нужна только для запуска на хосте: bun run dev, prisma db push.
# Путь обязательно абсолютный — для SQLite Prisma считает относительный путь
# от каталога prisma/schema.prisma, а не от корня проекта.
DATABASE_URL=file:/absolute/path/to/repo/db/custom.db
