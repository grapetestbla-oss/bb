generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  password      String
  role          String   @default("client") // client, booster, moderator, admin
  avatar        String?
  balance       Float    @default(0)
  rating        Float    @default(0)
  reviewsCount  Int      @default(0)
  verified      Boolean  @default(false)
  blocked       Boolean  @default(false)
  achievements  String   @default("[]") // JSON array of achievement IDs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services      Service[]  @relation("BoosterServices")
  orders        Order[]    @relation("ClientOrders")
  boosterOrders Order[]    @relation("BoosterOrders")
  reviewsGiven  Review[]   @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")
  sentMessages  ChatMessage[] @relation("MessageSender")
  notifications Notification[] @relation("UserNotifications")
  moderatorLogs ModeratorLog[] @relation("ModeratorActions")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    Service[]
}

model Service {
  id               String   @id @default(cuid())
  title            String
  description      String
  price            Float
  image            String?
  categoryId       String
  boosterId        String
  estimatedTime    String   @default("1-3 дня")
  features         String   @default("[]") // JSON array of feature strings
  requirements     String   @default("[]") // JSON array of requirement strings
  active           Boolean  @default(true)
  moderationStatus String   @default("approved") // pending, approved, rejected
  rejectionReason  String?
  ordersCount      Int      @default(0)
  rating           Float    @default(0)
  reviewsCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         Category @relation(fields: [categoryId], references: [id])
  booster          User     @relation("BoosterServices", fields: [boosterId], references: [id])
  orders           Order[]
  reviews          Review[]
}

model Order {
  id            String   @id @default(cuid())
  serviceId     String
  clientId      String
  boosterId     String?
  status        String   @default("pending") // pending, in_progress, completed, disputed, cancelled, refunded
  progress      Int      @default(0) // 0-100 percentage
  price         Float
  escrowLocked  Boolean  @default(true)
  clientNotes   String?
  boosterNotes  String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service       Service  @relation(fields: [serviceId], references: [id])
  client        User     @relation("ClientOrders", fields: [clientId], references: [id])
  booster       User?    @relation("BoosterOrders", fields: [boosterId], references: [id])
  messages      ChatMessage[]
  reviews       Review[]
}

model Review {
  id        String   @id @default(cuid())
  orderId   String
  serviceId String
  authorId  String
  targetId  String
  rating    Int      // 1-5
  comment   String
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id])
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id])
}

model ModeratorLog {
  id          String   @id @default(cuid())
  moderatorId String
  action      String
  target      String   // what was affected
  details     String?
  createdAt   DateTime @default(now())

  moderator   User     @relation("ModeratorActions", fields: [moderatorId], references: [id])
}

model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// KPGen — микро-SaaS: генератор коммерческих предложений.
// Полностью изолирован от BrawlBoost: свои пользователи, подписки и платежи.
// ---------------------------------------------------------------------------

model KpUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  company   String   @default("")
  plan      String   @default("free") // free, pro, business
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals     KpProposal[]
  payments      KpPayment[]
  subscriptions KpSubscription[]
}

model KpSubscription {
  id                 String   @id @default(cuid())
  userId             String
  plan               String   // pro, business
  status             String   @default("active") // active, cancelled, expired
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  provider           String   @default("mock")
  providerRef        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user KpUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KpProposal {
  id         String   @id @default(cuid())
  userId     String
  title      String
  clientName String
  brief      String   @default("{}")       // JSON брифа
  content    String   @default("")         // markdown
  engine     String   @default("template") // template | claude
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user KpUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KpPayment {
  id          String   @id @default(cuid())
  userId      String
  plan        String
  amount      Float
  currency    String   @default("RUB")
  status      String   @default("pending") // pending, succeeded, failed
  provider    String   @default("mock")
  providerRef String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user KpUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
